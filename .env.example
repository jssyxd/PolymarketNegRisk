# Environment configuration for Polymarket Neg-Risk Engine

# L1 Ethereum Private Key (Hex format without or with 0x prefix)
POLY_PRIVATE_KEY=your_private_key_here

# Polymarket Funder / Proxy Address (e.g., 0x...)
POLY_FUNDER_ADDRESS=your_funder_address_here

# Polymarket Signature Type: 0 = EOA, 1 = POLY_PROXY, 2 = GNOSIS_SAFE
POLY_SIGNATURE_TYPE=1

# Optional Level 2 CLOB API Credentials (auto-derived if omitted)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Strategy Defaults
NEG_RISK_INITIAL_CAPITAL=200.0
NEG_RISK_BUDGET_PER_ORDER=20.0
NEG_RISK_MIN_PROFIT_PCT=5.0
NEG_RISK_MAX_BOOK_SKEW_MS=300.0
NEG_RISK_SCAN_INTERVAL_SECONDS=20
